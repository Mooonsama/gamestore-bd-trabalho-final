generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  cpf             String   @id @db.VarChar(11)
  nome            String   @db.VarChar(100)
  email           String   @unique @db.VarChar(100)
  telefone        String?  @db.VarChar(15)
  data_nascimento DateTime? @db.Date
  rede_social     String?  @db.VarChar(100)
  senha_hash      String   @db.VarChar(255)
  
  usuario       Usuario?
  administrador Administrador?

  @@map("pessoa")
}

model Usuario {
  cpf String @id @db.VarChar(11)
  
  pessoa         Pessoa           @relation(fields: [cpf], references: [cpf], onDelete: Cascade)
  compras        Compra[]
  avaliacoes     Avaliacao[]
  cartoes        CartaoBancario[]

  @@map("usuario")
}

model Administrador {
  cpf         String   @id @db.VarChar(11)
  permissoes  String[]
  
  pessoa      Pessoa     @relation(fields: [cpf], references: [cpf], onDelete: Cascade)
  gerencias   Gerencia[]

  @@map("administrador")
}

model Desenvolvedora {
  cnpj          String @id @db.VarChar(14)
  nome          String @db.VarChar(100)
  nacionalidade String? @db.VarChar(50)
  
  jogos Jogo[]

  @@map("desenvolvedora")
}

model Jogo {
  id                Int      @id @default(autoincrement())
  nome              String   @db.VarChar(100)
  genero            String   @db.VarChar(50)
  descricao         String?
  data_lancamento   DateTime @db.Date
  valor             Decimal  @db.Decimal(10, 2)
  id_desenvolvedora String   @db.VarChar(14)
  
  desenvolvedora    Desenvolvedora    @relation(fields: [id_desenvolvedora], references: [cnpj])
  compras           Compra[]
  avaliacoes        Avaliacao[]
  gerencias         Gerencia[]
  curiosidades      CuriosidadeJogo[]

  @@map("jogo")
}

model CartaoBancario {
  id_usuario        String @db.VarChar(11)
  numero            String @db.VarChar(16)
  bandeira          String @db.VarChar(20)
  validade_mes      Int
  validade_ano      Int
  codigo_seguranca  String @db.VarChar(4)
  
  usuario Usuario @relation(fields: [id_usuario], references: [cpf], onDelete: Cascade)

  @@id([id_usuario, numero])
  @@map("cartao_bancario")
}

model Compra {
  id_usuario   String   @db.VarChar(11)
  id_jogo      Int
  data_compra  DateTime @default(now())
  valor_pago   Decimal  @db.Decimal(10, 2)
  
  usuario Usuario @relation(fields: [id_usuario], references: [cpf])
  jogo    Jogo    @relation(fields: [id_jogo], references: [id])

  @@id([id_usuario, id_jogo, data_compra])
  @@map("compra")
}

model Avaliacao {
  id_usuario       String   @db.VarChar(11)
  id_jogo          Int
  nota             Int
  texto            String?
  data_publicacao  DateTime @default(now()) @db.Date
  
  usuario Usuario @relation(fields: [id_usuario], references: [cpf])
  jogo    Jogo    @relation(fields: [id_jogo], references: [id])

  @@id([id_usuario, id_jogo])
  @@map("avaliacao")
}

model Gerencia {
  id_admin     String    @db.VarChar(11)
  id_jogo      Int
  data_inicio  DateTime  @default(now()) @db.Date
  data_fim     DateTime? @db.Date
  
  administrador Administrador @relation(fields: [id_admin], references: [cpf])
  jogo          Jogo          @relation(fields: [id_jogo], references: [id])

  @@id([id_admin, id_jogo, data_inicio])
  @@map("gerencia")
}

model CuriosidadeJogo {
  id      Int    @id @default(autoincrement())
  id_jogo Int
  texto   String
  
  jogo Jogo @relation(fields: [id_jogo], references: [id], onDelete: Cascade)

  @@map("curiosidade_jogo")
}